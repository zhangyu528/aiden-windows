<Window x:Class="Aiden.TrayMonitor.Views.StartupLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aiden Monitor"
        Width="960"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Grid Background="#FF0B0F14">
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="620" Height="620" Canvas.Left="-140" Canvas.Top="-220" Fill="#261978E5">
        <Ellipse.Effect>
          <BlurEffect Radius="140" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="560" Height="560" Canvas.Right="-120" Canvas.Bottom="-180" Fill="#1A1D4ED8">
        <Ellipse.Effect>
          <BlurEffect Radius="140" />
        </Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="576">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" HorizontalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="14" Background="#FF1978E5" BorderBrush="#19FFFFFF" BorderThickness="1">
          <TextBlock Text="A" Foreground="White" FontFamily="Inter" FontSize="30" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="AIDEN TRAY" Margin="0,12,0,0" Foreground="#CC1978E5" FontFamily="Inter" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>

      <Viewbox Grid.Row="1" Margin="0,44,0,34" Width="64" Height="64" HorizontalAlignment="Center">
        <Grid Width="64" Height="64">
          <Ellipse Width="64" Height="64" Stroke="#FF1E293B" StrokeThickness="3" />
          <Path Stroke="#FF1978E5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M32,2 A30,30 0 0 1 62,32">
            <Path.RenderTransform>
              <RotateTransform x:Name="SpinnerRotate" CenterX="32" CenterY="32" />
            </Path.RenderTransform>
            <Path.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                     From="0"
                                     To="360"
                                     Duration="0:0:1.5" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Path.Triggers>
          </Path>
        </Grid>
      </Viewbox>

      <StackPanel Grid.Row="2" HorizontalAlignment="Center">
        <TextBlock Text="Starting Services..."
                   Foreground="White"
                   FontFamily="Inter"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Launching VictoriaMetrics..."
                   Margin="0,12,0,0"
                   Foreground="#FF94A3B8"
                   FontFamily="Inter"
                   FontSize="18"
                   FontWeight="Medium"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Backend infrastructure preparation"
                   Margin="0,4,0,0"
                   Foreground="#8064748B"
                   FontFamily="Inter"
                   FontSize="13"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="0,50,0,0" HorizontalAlignment="Center" Opacity="0.7">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="&#xF0BE;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" Foreground="#FF1978E5" FontSize="12" Margin="0,0,8,0" />
          <TextBlock Text="Environment check complete" Foreground="#FF94A3B8" FontFamily="Inter" FontSize="13" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="&#xE627;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" Foreground="#FF1978E5" FontSize="12" Margin="0,0,8,0" />
          <TextBlock Text="Starting OTel Collector..." Foreground="#FFE2E8F0" FontFamily="Inter" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="6" Height="6" Fill="#FF334155" Margin="3,0,11,0" VerticalAlignment="Center" />
          <TextBlock Text="Initializing Aiden Tray..." Foreground="#8064748B" FontFamily="Inter" FontSize="13" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <TextBlock VerticalAlignment="Bottom"
               HorizontalAlignment="Center"
               Margin="0,0,0,24"
               Foreground="#8064748B"
               FontFamily="Inter"
               FontSize="10"
               FontWeight="Bold"
               Text="Powered by Aiden Systems v2.4.0-Stable" />
  </Grid>
</Window>
