<Window x:Class="Aiden.TrayMonitor.Views.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aiden Monitor"
        Width="520"
        Height="400"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Grid Background="#FF111821">
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="520" Height="520" Canvas.Left="-140" Canvas.Top="-140" Fill="#141978E5">
        <Ellipse.Effect>
          <BlurEffect Radius="120" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="520" Height="520" Canvas.Right="-160" Canvas.Bottom="-180" Fill="#14EF4444">
        <Ellipse.Effect>
          <BlurEffect Radius="120" />
        </Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <Border Margin="18"
            CornerRadius="12"
            Background="#99202D3C"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#FF000000" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="30" Height="30" CornerRadius="8" Background="#1A1978E5">
                <TextBlock Text="&#xF190;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" Foreground="#FF1978E5" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Aiden Tray Monitor" Margin="10,0,0,0" Foreground="#CCFFFFFF" FontFamily="Inter" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Width="34"
                      Height="30"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#FF94A3B8"
                      FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined"
                      FontSize="16"
                      Content="&#xE931;"
                      Cursor="Arrow"
                      IsHitTestVisible="False" />
              <Button Width="34"
                      Height="30"
                      Click="OnExitClick"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#FF94A3B8"
                      FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined"
                      FontSize="16"
                      Content="&#xE5CD;"
                      Cursor="Hand" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="30,28,30,24" HorizontalAlignment="Center">
          <Border Width="80" Height="80" CornerRadius="40" Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" HorizontalAlignment="Center">
            <TextBlock Text="&#xF8B6;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" Foreground="#FFEF4444" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <TextBlock Text="Startup Failed: Port Conflict Detected"
                     Margin="0,20,0,10"
                     Foreground="White"
                     FontFamily="Inter"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />

          <TextBlock Text="It looks like port 4317 is already in use by another application. Please ensure the port is available and try again."
                     Foreground="#FF94A3B8"
                     FontFamily="Inter"
                     FontSize="16"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="390" />

          <Border Margin="0,14,0,0" Padding="10" CornerRadius="8" Background="#1A000000" BorderBrush="#22FFFFFF" BorderThickness="1">
            <TextBlock Text="{Binding ErrorText}" Foreground="#FFFCA5A5" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="22,14" Background="#33000000" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Height="40"
                    Padding="16,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF94A3B8"
                    FontFamily="Inter"
                    FontSize="14"
                    FontWeight="Medium"
                    Content="Exit"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="OnExitClick" />

            <Button Grid.Column="1"
                    Height="40"
                    MinWidth="140"
                    Padding="14,9"
                    Background="#FF1978E5"
                    BorderBrush="#FF1978E5"
                    BorderThickness="1"
                    Foreground="White"
                    FontFamily="Inter"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OnRetryClick">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE5D5;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Retry Startup" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
