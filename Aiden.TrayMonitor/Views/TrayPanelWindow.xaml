<Window x:Class="Aiden.TrayMonitor.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aiden.TrayMonitor.Converters"
        Title="Aiden Monitor"
        Width="360"
        Height="398"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
  <Window.Resources>
    <local:ContextPercentConverter x:Key="ContextPercentConverter" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B8CEE" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D9101922" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TextMainBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="OnlineBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#FFF87171" />

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FF64748B" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
  </Window.Resources>

  <Border CornerRadius="16"
          Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}"
          BorderThickness="1"
          Padding="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Aiden Monitor" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="22"
                  MinWidth="74"
                  Padding="9,0"
                  CornerRadius="11"
                  BorderThickness="1"
                  Margin="0,0,8,0"
                  SnapsToDevicePixels="True">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#1A22C55E" />
                <Setter Property="BorderBrush" Value="#6622C55E" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Background" Value="#1AEF4444" />
                    <Setter Property="BorderBrush" Value="#66EF4444" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                    <Setter Property="Effect">
                      <Setter.Value>
                        <DropShadowEffect Color="#AA22C55E" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                        <Setter Property="Effect" Value="{x:Null}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Grid.Column="1"
                         Text="{Binding StatusText}"
                         FontSize="10"
                         FontWeight="Bold"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource OnlineBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource OfflineBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

          <Button Width="32" Height="32"
                  Command="{Binding RefreshCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource TextMutedBrush}"
                  FontSize="18"
                  FontFamily="Segoe MDL2 Assets"
                  Content="&#xE72C;"
                  ToolTip="Refresh" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="24,0,24,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
          <Grid Width="44" Height="44">
            <Ellipse Fill="#332B8CEE" Stroke="#4D2B8CEE" StrokeThickness="1" />
            <TextBlock Text="U" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="10" Height="10" Fill="{StaticResource OnlineBrush}" Stroke="#FF101922" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
          <StackPanel Margin="10,3,0,0">
            <TextBlock Text="{Binding CurrentUserEmail}" Foreground="{StaticResource TextMainBrush}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UserActiveAtText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Medium" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#1AFFFFFF" />
      </Grid>

      <Grid Grid.Row="2" Margin="20,20,20,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F3;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Style="{StaticResource MetricTitleStyle}" Text="INPUT" />
            </StackPanel>
            <TextBlock Text="{Binding InputText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,0,0,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Style="{StaticResource MetricTitleStyle}" Text="OUTPUT" />
            </StackPanel>
            <TextBlock Text="{Binding OutputText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,6,6,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEAFD;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Style="{StaticResource MetricTitleStyle}" Text="EST. COST" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="{Binding SessionCostUsd, StringFormat=${0:F4}}" Foreground="White" FontSize="20" FontWeight="Bold" />
              <TextBlock Text=" USD" Foreground="#FF64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,1" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,6,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Style="{StaticResource MetricTitleStyle}" Text="CONTEXT" />
            </StackPanel>
            <DockPanel Margin="0,6,0,0">
              <TextBlock Text="{Binding ContextText}" Foreground="White" FontSize="13" FontWeight="Bold" DockPanel.Dock="Left" />
              <TextBlock Text="{Binding ContextText, Converter={StaticResource ContextPercentConverter}, StringFormat={}{0:F1}%}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar Height="5" Margin="0,8,0,0" Maximum="100"
                         Value="{Binding ContextText, Converter={StaticResource ContextPercentConverter}}"
                         Foreground="{StaticResource PrimaryBrush}"
                         Background="#FF1E293B"
                         BorderThickness="0" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Background="#40000000" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,16,0,16">
          <TextBlock Text="&#xE713;"
                     FontFamily="Segoe MDL2 Assets"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="14" />
          <TextBlock Text="  Settings" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" />
        </StackPanel>

        <Button Grid.Column="1"
                Click="OnExitClick"
                Margin="0,12,24,12"
                Padding="10,6"
                Background="#1AF87171"
                BorderBrush="#33F87171"
                BorderThickness="1"
                Foreground="#FFF87171"
                FontSize="11"
                FontWeight="Bold"
                Content="EXIT" />
      </Grid>

      <Grid Grid.Row="4" Height="10">
        <Border Width="40" Height="4" Background="#1AFFFFFF" CornerRadius="999" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>

