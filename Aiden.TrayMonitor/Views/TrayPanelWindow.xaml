<Window x:Class="Aiden.TrayMonitor.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aiden Monitor"
        Width="360"
        SizeToContent="Height"
        MinHeight="470"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF1978E5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D9111821" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextMainBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="OnlineBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#FFEF4444" />

    <Style x:Key="MaterialIconStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#08FFFFFF" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="TabButtonBaseStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FF94A3B8" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabStateButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonBaseStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="#FF1978E5" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect Color="#331978E5" BlurRadius="12" ShadowDepth="0" Opacity="1" />
            </Setter.Value>
          </Setter>
        </DataTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="Tag" Value="False" />
            <Condition Property="IsMouseOver" Value="True" />
            <Condition Property="IsEnabled" Value="True" />
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="#0DFFFFFF" />
          <Setter Property="Foreground" Value="#FFE2E8F0" />
        </MultiTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Foreground" Value="#FF64748B" />
          <Setter Property="Effect" Value="{x:Null}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FooterSettingsButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FF94A3B8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ExitButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="Background" Value="#1AEF4444" />
      <Setter Property="BorderBrush" Value="#33EF4444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFF87171" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#33EF4444" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="16"
          Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}"
          BorderThickness="1"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.4" Color="#FF000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="&#xF190;" Style="{StaticResource MaterialIconStyle}" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Aiden Monitor" Margin="10,0,0,0" Foreground="{StaticResource TextMainBrush}" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1"
                Height="20"
                MinWidth="82"
                Padding="10,0"
                CornerRadius="10"
                BorderThickness="1"
                VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#2622C55E" />
              <Setter Property="BorderBrush" Value="#3322C55E" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                  <Setter Property="Background" Value="#26EF4444" />
                  <Setter Property="BorderBrush" Value="#33EF4444" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                  <Setter Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#9922C55E" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                      <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                      <Setter Property="Effect" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="Inter"
                       FontSize="10"
                       FontWeight="Bold"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource OnlineBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource OfflineBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Margin="24,0,24,16" Background="#33000000" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
        <UniformGrid Columns="3">
          <Button Content="Gemini"
                  Style="{StaticResource TabStateButtonStyle}"
                  Tag="{Binding IsGeminiSelected}"
                  IsEnabled="{Binding IsGeminiEnabled}"
                  Command="{Binding SelectGeminiCommand}" />
          <Button Content="Codex"
                  Style="{StaticResource TabStateButtonStyle}"
                  Tag="{Binding IsCodexSelected}"
                  IsEnabled="{Binding IsCodexEnabled}"
                  Command="{Binding SelectCodexCommand}" />
          <Button Content="Claude"
                  Style="{StaticResource TabStateButtonStyle}"
                  Tag="{Binding IsClaudeSelected}"
                  IsEnabled="{Binding IsClaudeEnabled}"
                  Command="{Binding SelectClaudeCommand}" />
        </UniformGrid>
      </Border>

      <Border Grid.Row="2" Margin="24,0,24,0" Padding="0,16" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,1" Background="#05FFFFFF">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center">
            <Ellipse Fill="#FF2563EB" Stroke="#19FFFFFF" StrokeThickness="1" />
            <TextBlock Text="U" Foreground="White" FontFamily="Inter" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="12" Height="12" Fill="{StaticResource OnlineBrush}" Stroke="#FF111821" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentUserEmail}" Foreground="{StaticResource TextMainBrush}" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UserActiveAtText}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Inter" FontSize="11" FontWeight="Medium" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="20,20,20,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,6">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xEA77;"
                         Style="{StaticResource MaterialIconStyle}"
                         Foreground="{StaticResource PrimaryBrush}"
                         FontSize="18"
                         Width="18"
                         Height="18"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="INPUT"
                         Foreground="{StaticResource TextDimBrush}"
                         FontFamily="Inter"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="8,1,0,0"
                         VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding InputText}" Foreground="White" FontFamily="Inter" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,0,0,6">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xE9BA;"
                         Style="{StaticResource MaterialIconStyle}"
                         Foreground="{StaticResource PrimaryBrush}"
                         FontSize="18"
                         Width="18"
                         Height="18"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="OUTPUT"
                         Foreground="{StaticResource TextDimBrush}"
                         FontFamily="Inter"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="8,1,0,0"
                         VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding OutputText}" Foreground="White" FontFamily="Inter" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,6,6,0">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xEF63;"
                         Style="{StaticResource MaterialIconStyle}"
                         Foreground="{StaticResource PrimaryBrush}"
                         FontSize="18"
                         Width="18"
                         Height="18"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="EST. COST"
                         Foreground="{StaticResource TextDimBrush}"
                         FontFamily="Inter"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="8,1,0,0"
                         VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBlock Text="{Binding SessionCostUsd, StringFormat=${0:F2}}" Foreground="White" FontFamily="Inter" FontSize="20" FontWeight="Bold" />
              <TextBlock Text=" USD" Foreground="{StaticResource TextDimBrush}" FontFamily="Inter" FontSize="10" FontWeight="Medium" Margin="2,0,0,1" VerticalAlignment="Bottom" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,6,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xF20E;"
                         Style="{StaticResource MaterialIconStyle}"
                         Foreground="{StaticResource PrimaryBrush}"
                         FontSize="18"
                         Width="18"
                         Height="18"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="CONTEXT"
                         Foreground="{StaticResource TextDimBrush}"
                         FontFamily="Inter"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="8,1,0,0"
                         VerticalAlignment="Center" />
            </Grid>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding ContextText}" DockPanel.Dock="Left" Foreground="White" FontFamily="Inter" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="{Binding ContextPercent, StringFormat={}{0:F1}%}"
                         Foreground="{StaticResource PrimaryBrush}"
                         FontFamily="Inter"
                         FontSize="10"
                         FontWeight="Bold"
                         HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar Height="6"
                         Maximum="100"
                         Value="{Binding ContextPercent}"
                         Foreground="{StaticResource PrimaryBrush}"
                         Background="#FF1E293B"
                         BorderThickness="0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="4" Background="#40000000" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="24,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Style="{StaticResource FooterSettingsButtonStyle}"
                  Command="{Binding OpenSettingsCommand}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xE8B8;"
                         Style="{StaticResource MaterialIconStyle}"
                         FontSize="20"
                         Width="20"
                         Height="20"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Text="Settings"
                         FontFamily="Inter"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Grid.Column="1" Style="{StaticResource ExitButtonStyle}" Click="OnExitClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xF8C7;" Style="{StaticResource MaterialIconStyle}" FontSize="18" Margin="0,0,4,0" />
              <TextBlock Text="EXIT" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="5" Height="10">
        <Border Width="40" Height="4" CornerRadius="999" Background="#1AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
      </Grid>
    </Grid>
  </Border>
</Window>
