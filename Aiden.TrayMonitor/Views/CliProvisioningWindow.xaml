<Window x:Class="Aiden.TrayMonitor.Views.CliProvisioningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLI Provisioning"
        Width="640"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F172A">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{Binding TitleText}" Foreground="#FFE2E8F0" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SubtitleText}" Foreground="#FF94A3B8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="8">
      <DataGrid x:Name="CliGrid"
                ItemsSource="{Binding Items}"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                SelectionMode="Single"
                RowHeaderWidth="0"
                Background="Transparent"
                Foreground="#FFE2E8F0"
                BorderThickness="0">
        <DataGrid.Resources>
          <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
          </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn Header="CLI" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True" />
          <DataGridTextColumn Header="Install" Binding="{Binding InstallStatusText}" Width="90" IsReadOnly="True" />
          <DataGridTemplateColumn Header="Enabled" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsInstalled}"
                          Click="OnToggleClick"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Config Path" Binding="{Binding ConfigPath}" Width="220" IsReadOnly="True" />
          <DataGridTextColumn Header="Install Hint" Binding="{Binding InstallHint}" Width="*" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding NoticeText}"
                 Foreground="#FFFCA5A5"
                 VerticalAlignment="Center"
                 FontSize="12" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Refresh"
                Width="88"
                Margin="0,0,8,0"
                Click="OnRefreshClick" />
        <Button Content="{Binding ContinueButtonText}"
                Width="120"
                IsEnabled="{Binding CanContinue}"
                Click="OnContinueClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
