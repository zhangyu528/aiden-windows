<Window x:Class="Aiden.TrayMonitor.Views.CliProvisioningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLI Provisioning"
        Width="800"
        Height="760"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF1978E5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D9111821" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextMainBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF64748B" />

    <Style x:Key="FluentToggleStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="Track"
                      Background="#0DFFFFFF"
                      BorderBrush="#66FFFFFF"
                      BorderThickness="1"
                      CornerRadius="10" />
              <Ellipse x:Name="Thumb"
                       Width="12"
                       Height="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"
                       Fill="White" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#FF0078D4" />
                <Setter TargetName="Track" Property="BorderBrush" Value="#FF0078D4" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="40,10" />
      <Setter Property="Background" Value="#FF1978E5" />
      <Setter Property="BorderBrush" Value="#FF1978E5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InstallBadgeStyle" TargetType="Border">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
          <Setter Property="Background" Value="#1A22C55E" />
          <Setter Property="BorderBrush" Value="#4D22C55E" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="560" Height="560" Canvas.Left="-120" Canvas.Top="-120" Fill="#241978E5">
        <Ellipse.Effect>
          <BlurEffect Radius="140" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="520" Height="520" Canvas.Right="-120" Canvas.Bottom="-120" Fill="#1A60A5FA">
        <Ellipse.Effect>
          <BlurEffect Radius="140" />
        </Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <Border CornerRadius="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.5" Color="#FF000000" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="32,30,32,22">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" Background="#FF1978E5">
              <TextBlock Text="&#xEB8E;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" FontSize="30" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="CLI Management"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextMainBrush}"
                       FontFamily="Inter"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Text="Configure installation status and telemetry settings for your AI command-line tools."
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Inter"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="560" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,32">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontFamily="Inter" FontSize="18" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Foreground" Value="#FF64748B" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Border Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource InstallBadgeStyle}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xF8B6;" />
                                <Setter Property="Foreground" Value="#FF94A3B8" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Text" Value="&#xF0BE;" />
                                    <Setter Property="Foreground" Value="#FF4ADE80" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock FontFamily="Inter" FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="NOT DETECTED" />
                                <Setter Property="Foreground" Value="#FF94A3B8" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Text" Value="INSTALLED" />
                                    <Setter Property="Foreground" Value="#FF4ADE80" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#8094A3B8"
                               FontFamily="Inter"
                               FontSize="11"
                               FontStyle="Italic"
                               Text="Detected locally">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <Border Margin="0,14,0,0" Padding="18" CornerRadius="12" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#0DFFFFFF" />
                        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Background" Value="#0D000000" />
                            <Setter Property="BorderBrush" Value="#55FFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <Grid>
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Visible" />
                        </Style>
                      </Grid.Style>

                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Grid>
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Enable Telemetry" Foreground="White" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" />
                          <TextBlock Text="Allow Aiden Monitor to track CLI token usage and latency metrics for historical reporting."
                                     Foreground="{StaticResource TextMutedBrush}"
                                     FontFamily="Inter"
                                     FontSize="12"
                                     Margin="0,6,0,0"
                                     TextWrapping="Wrap"
                                     MaxWidth="520" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsInstalled}"
                                  Style="{StaticResource FluentToggleStyle}"
                                  Click="OnToggleClick" />
                      </Grid>

                      <StackPanel>
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                          <Border Width="30" Height="30" CornerRadius="15" Background="#1AFFFFFF">
                            <TextBlock Text="&#xEB8E;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" Foreground="#FF94A3B8" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="Run this command to install:"
                                     Foreground="#FF94A3B8"
                                     FontFamily="Inter"
                                     FontSize="14"
                                     FontWeight="Medium"
                                     Margin="10,5,0,0" />
                        </StackPanel>
                        <Border Background="#FF0F172A" BorderBrush="#331E293B" BorderThickness="1" CornerRadius="8" Padding="10,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding InstallHint}" Foreground="#FFCBD5E1" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#FF1978E5"
                                    Cursor="Hand"
                                    Click="OnCopyInstallCommandClick">
                              <TextBlock Text="&#xE14D;" FontFamily="pack://application:,,,/Aiden.TrayMonitor;component/Assets/Fonts/#Material Symbols Outlined" FontSize="16" />
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Background="#08000000" Padding="24,16">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClick" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
